    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-12">


<h1>
    {% if logistic is defined and logistic %}Edit Logistic Item{% else %}Add a New Logistique{% endif %}
</h1>

{{ form_start(form, {
    'action': path(logistic is defined and logistic ? 'app_logistic_update' : 'app_logistics'),
    'method': 'POST',
    'attr': { 'enctype': 'multipart/form-data' }
}) }}

{% if logistic is defined and logistic %}
    <input type="hidden" name="id" value="{{ logistic.id }}">
{% endif %}

{{ form_widget(form) }}

{% if logistic is defined and logistic and logistic.image %}
    <p>Current Image:</p>
    <img src="{{ asset(logistic.image) }}" alt="Logistic Image" width="200">
{% endif %}

<button type="submit" class="btn btn-primary">
    {% if logistic is defined and logistic %}Update{% else %}Add{% endif %}
</button>

{{ form_end(form) }}


    <a href="{{ path('logistique_list') }}">See  List</a>

            </div>

        </div>
    </div>

