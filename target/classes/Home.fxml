                <ImageView fitHeight="943.0" fitWidth="1495.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@img/479691982_511439215322900_2595267402218371023_n.png" />
                    </image>
                </ImageView>
                <VBox layoutX="300.0" layoutY="200.0" prefHeight="129.0" prefWidth="1200.0" spacing="20.0" style="-fx-alignment: center;">
                    <children>
                        <Label style="-fx-font-size: 40px; -fx-text-fill: white; -fx-font-weight: bold;" text="Planify your event with us" />
                        <Label style="-fx-font-size: 20px; -fx-text-fill: white;" text="Our goal is perfection" />
                        <Button style="-fx-background-color: #CF97FF; -fx-text-fill: white; -fx-font-size: 16px;" text="Personalize your event" />
                    </children>
                    <VBox.margin>
                        <Insets top="-200.0" />
                    </VBox.margin>
                    <padding>
                        <Insets top="-800.0" />
                    </padding>
                </VBox>
            </children>
        </VBox>
        <!-- Statistiques -->
        <HBox layoutY="1050.0" prefHeight="80.0" prefWidth="1200.0" spacing="50.0" style="-fx-alignment: center;" AnchorPane.bottomAnchor="14.0">
            <children>
                <VBox spacing="5.0" style="-fx-alignment: center;">
                    <Label style="-fx-font-size: 24px; -fx-text-fill: #CF97FF; -fx-font-weight: bold;" text="350+" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #000000;" text="Events" />
                </VBox>
                <VBox spacing="5.0" style="-fx-alignment: center;">
                    <Label style="-fx-font-size: 24px; -fx-text-fill: #CF97FF; -fx-font-weight: bold;" text="150+" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #000000;" text="Decorations" />
                    <HBox.margin>
                        <Insets />
                    </HBox.margin>
                </VBox>
                <VBox spacing="5.0" style="-fx-alignment: center;">
                    <Label style="-fx-font-size: 24px; -fx-text-fill: #CF97FF; -fx-font-weight: bold;" text="8+" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #000000;" text="Years of experience" />
                </VBox>
                <VBox spacing="5.0" style="-fx-alignment: center;">
                    <Label style="-fx-font-size: 24px; -fx-text-fill: #CF97FF; -fx-font-weight: bold;" text="15K+" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #000000;" text="Reservations" />
                </VBox>
            </children>
        </HBox>
        <ImageView fitHeight="169.0" fitWidth="291.0" layoutX="-40.0" layoutY="-59.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@img/475024986_3052058898283782_7784334910321707512_n-removebg-preview_(1).png" />
            </image>
        </ImageView>
    </children>
</AnchorPane>
