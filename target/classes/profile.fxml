                                    <ImageView fitHeight="32.0" fitWidth="52.0" pickOnBounds="true" preserveRatio="true" styleClass="imageview">
                                        <image>
                                            <Image url="@img/utilisateur (1).png" />
                                        </image>
                                    </ImageView>
                                </graphic>
