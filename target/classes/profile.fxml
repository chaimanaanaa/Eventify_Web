                    <children>
                        <Button fx:id="home" mnemonicParsing="false" onAction="#goToHome" style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-font-weight: bold;-fx-border-width: 0 0 2px 0; -fx-border-style: solid; -fx-border-color: #CF97FF; -fx-border-insets: 10px; -fx-border-radius: 0;" stylesheets="@css/Home.css" text="Home" />
