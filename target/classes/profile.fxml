                        <Button fx:id="logistics" mnemonicParsing="false" onAction="#goToLogistics" style="-fx-background-color: transparent;" styleClass="Home-button" stylesheets="@css/Home.css" text="Logistics" />
                        <Button fx:id="organizer" mnemonicParsing="false" onAction="#goToOrganizers" style="-fx-background-color: transparent;" styleClass="Home-button" stylesheets="@css/Home.css" text="Organizers" />
                    </children>
                    <HBox layoutX="900.0" layoutY="10.0" prefHeight="46.0" prefWidth="146.0" spacing="20.0" style="-fx-padding: 15px;">
