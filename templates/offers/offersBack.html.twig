        <i class="fas fa-robot"></i> AI Select Organizer
      </button>
    </form>
  </div>
</div>

<a href="#" class="delete-btn" data-offer-id="{{ offer.id }}"><i class="fas fa-trash-alt"></i> Delete</a>                      
