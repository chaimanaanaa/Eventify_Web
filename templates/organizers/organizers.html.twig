<style>

        #aiIconButton {
            font-size: 28px; /* Slightly larger for better wave visibility */
            background-color: #28a745;
            color: white;
            border: none;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            cursor: pointer;
            transition: background-color 0.3s;
            display: flex;
            justify-content: center;
            align-items: center;
            position: absolute;
            bottom: 500px;
            right: 200px;
            animation: bounce 2s infinite ease-in-out;
        }
        #aiIconButton:hover {
            background-color: #218838;
            animation-play-state: paused;
        }
        #aiIconButton.wave {
            animation: waveIcon 1.5s ease-in-out;
        }
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        @keyframes waveIcon {
            0% { transform: rotate(0deg); }
            25% { transform: rotate(-15deg); }
            75% { transform: rotate(15deg); }
            100% { transform: rotate(0deg); }
        }
        #aiModal {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            max-width: 600px;
            width: 90%;
            text-align: center;
            z-index: 99999;
        }
        #aiModal.show {
            display: block;
        }
        #aiImage {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            margin: 0 auto;
        }
        #voiceBar {
            margin: 20px 0;
            height: 30px;
            display: flex;
            justify-content: center;
            align-items: center;
            visibility: hidden;
        }
        #voiceBar.active {
            visibility: visible;
        }
        .bar {
            width: 4px;
            height: 10px;
            background-color: #007bff;
            margin: 0 2px;
            animation: wave 0.5s infinite alternate;
        }
        .bar:nth-child(2) { animation-delay: 0.1s; }
        .bar:nth-child(3) { animation-delay: 0.2s; }
        .bar:nth-child(4) { animation-delay: 0.3s; }
        .bar:nth-child(5) { animation-delay: 0.4s; }
        @keyframes wave {
            0% { transform: scaleY(1); }
            100% { transform: scaleY(3); }
        }
        #status {
            font-size: 16px;
            color: #333;
            margin-bottom: 20px;
        }
        #closeModal {
            padding: 10px 20px;
            font-size: 14px;
            background-color: #dc3545;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s;
        }
        #closeModal:hover {
            background-color: rgb(36, 147, 61);
        }

</style>
