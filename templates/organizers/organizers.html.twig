<!-------------------------------- Taba3 il AI AGENT  ------------------------------------------------->
 <button id="aiIconButton" title="Talk to AI"><i class="fas fa-robot"></i></button>
    <div id="aiModal">   
    <spline-viewer url="https://prod.spline.design/dwQs9CeuVXSEFh6Y/scene.splinecode"></spline-viewer>
    
        <div id="voiceBar">
            <div class="bar"></div>
            <div class="bar"></div>
            <div class="bar"></div>
            <div class="bar"></div>
            <div class="bar"></div>
        </div>
        <div id="status">Click the icon to start</div>
        <button 
            id="closeModal" 
            style="background: linear-gradient(to right, #dc3545, #ff6b6b, #ff9f43, #007bff); color: white; border: none; padding: 10px 20px; font-size: 14px; border-radius: 5px; cursor: pointer; transition: background 0.3s;" 
            onmouseover="this.style.background='linear-gradient(to bottom, #dc3545, #ff6b6b, #ff9f43, #007bff)'" 
            onmouseout="this.style.background='linear-gradient(to right, #dc3545, #ff6b6b, #ff9f43, #007bff)'">
            Close
        </button>

    </div>

    <script>
        const aiIconButton = document.getElementById('aiIconButton');
        const aiModal = document.getElementById('aiModal');
        const closeModal = document.getElementById('closeModal');
        const voiceBar = document.getElementById('voiceBar');
        const status = document.getElementById('status');
        let recognition;
        let isListening = false;
        let finalTranscript = '';
        let silenceTimeout;


        // Add this new function
        function refreshSplineViewer() {
            const splineViewer = document.querySelector('spline-viewer');
            if (splineViewer) {
                splineViewer.remove();
            }
            const newViewer = document.createElement('spline-viewer');
            newViewer.setAttribute('url', 'https://prod.spline.design/dwQs9CeuVXSEFh6Y/scene.splinecode');
            document.querySelector('#aiModal').prepend(newViewer);
            // Re-apply logo removal
            setTimeout(() => {
                const shadow = newViewer.shadowRoot;
                if (shadow) {
                    const logoLink = shadow.querySelector('a');
                    if (logoLink) {
                        logoLink.remove();
                    }
                }
            }, 1);
        }

        if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            recognition = new SpeechRecognition();
            recognition.continuous = true;
            recognition.interimResults = true;
            recognition.lang = 'en-US';

            recognition.onresult = async (event) => {
                let interimTranscript = '';
                for (let i = event.resultIndex; i < event.results.length; i++) {
                    const transcript = event.results[i][0].transcript;
                    if (event.results[i].isFinal) {
                        finalTranscript += transcript + ' ';
                    } else {
                        interimTranscript += transcript;
                    }
                }
                status.textContent = `You said: ${finalTranscript + interimTranscript}`;

                clearTimeout(silenceTimeout);
                silenceTimeout = setTimeout(async () => {
                    if (finalTranscript.trim()) {
                        try {
                            const response = await fetch('{{ path('api_ask') }}', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ question: finalTranscript.trim() })
                            });
                            if (!response.ok) {
                                throw new Error(`HTTP error! Status: ${response.status}`);
                            }
                            const data = await response.json();
                            if (data.answer) {
                                status.textContent = `AI: ${data.answer}`;
                                const utterance = new SpeechSynthesisUtterance(data.answer);
                                utterance.lang = 'en-US';
                                utterance.onstart = () => voiceBar.classList.add('active');
                                utterance.onend = () => {
                                    voiceBar.classList.remove('active');
                                    if (isListening) recognition.start();
                                };
                                window.speechSynthesis.speak(utterance);
                                recognition.stop();
                            } else {
                                status.textContent = 'Error: No response from AI';
                            }
                            finalTranscript = '';
                        } catch (error) {
                            status.textContent = `Fetch error: ${error.message}`;
                        }
                    }
                }, 1500);
            };

            recognition.onerror = (event) => {
                status.textContent = `Speech recognition error: ${event.error}`;
                stopListening();
            };

            recognition.onend = () => {
                if (isListening && !window.speechSynthesis.speaking) {
                    recognition.start();
                }
            };
        } else {
            status.textContent = 'Web Speech API not supported';
            aiIconButton.disabled = true;
        }

        // Replace the existing startListening function
        async function startListening() {
            isListening = true;
            refreshSplineViewer(); // Refresh spline-viewer before showing modal
            aiModal.classList.add('show');
            aiIconButton.classList.add('wave');
            status.textContent = 'Starting...';

            try {
                const response = await fetch('{{ path('api_greet') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({})
                });
                if (!response.ok) {
                    throw new Error(`HTTP error! Status: ${response.status}`);
                }
                const data = await response.json();
                if (data.greeting) {
                    status.textContent = `AI: ${data.greeting}`;
                    const utterance = new SpeechSynthesisUtterance(data.greeting);
                    utterance.lang = 'en-US';
                    utterance.onstart = () => voiceBar.classList.add('active');
                    utterance.onend = () => {
                        voiceBar.classList.remove('active');
                        aiIconButton.classList.remove('wave');
                        recognition.start();
                        status.textContent = 'Listening...';
                    };
                    window.speechSynthesis.speak(utterance);
                } else {
                    status.textContent = 'Error: No greeting from AI';
                    aiIconButton.classList.remove('wave');
                    recognition.start();
                }
            } catch (error) {
                status.textContent = `Greeting fetch error: ${error.message}`;
                aiIconButton.classList.remove('wave');
                recognition.start();
            }
        }

        function stopListening() {
            isListening = false;
            aiModal.classList.remove('show');
            aiIconButton.classList.remove('wave');
            recognition.stop();
            clearTimeout(silenceTimeout);
            finalTranscript = '';
            status.textContent = 'Click the icon to start';
            window.speechSynthesis.cancel();
            voiceBar.classList.remove('active');
        }

        aiIconButton.addEventListener('click', () => {
            if (!isListening) {
                startListening();
            }
        });

        closeModal.addEventListener('click', () => {
            stopListening();
        });




          // Remove Spline viewer logo link
        window.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => {
                const splineViewer = document.querySelector('spline-viewer');
                const shadow = splineViewer?.shadowRoot;
                if (shadow) {
                    const logoLink = shadow.querySelector('a');
                    if (logoLink) {
                        logoLink.remove();
                        console.log('Lien supprimé.');
                    }
                } else {
                    console.log('Le shadow DOM est fermé.');
                }
            }, 1);
        });

        
    </script> 
