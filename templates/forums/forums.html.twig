document.querySelectorAll('.comment-form form').forEach(form => {
    form.addEventListener('submit', function(e) {
        const textarea = this.querySelector('textarea');
        const content = textarea.value.toLowerCase();
        const badwords = [
            'fuck', 'shit', 'stupid', 'bitch', 'damn', 
            'merde', 'putain', 'connard', 'salope', 'bad'
        ];
        
        // Création d'une alerte stylisée
        function showBadWordAlert(message) {
            // Supprimer les anciennes alertes
            const oldAlert = document.querySelector('.badword-alert');
            if (oldAlert) oldAlert.remove();
            
            // Créer une nouvelle alerte
            const alertDiv = document.createElement('div');
            alertDiv.className = 'badword-alert alert alert-danger position-fixed';
            alertDiv.style.top = '20px';
            alertDiv.style.right = '20px';
            alertDiv.style.zIndex = '2000';
            alertDiv.style.maxWidth = '300px';
            alertDiv.innerHTML = `
                <i class="fas fa-exclamation-triangle me-2"></i>
                ${message}
                <button type="button" class="btn-close ms-2" data-bs-dismiss="alert" aria-label="Close"></button>
            `;
            
            document.body.appendChild(alertDiv);
            
            // Fermeture automatique après 5 secondes
            setTimeout(() => {
                alertDiv.classList.add('fade-out');
                setTimeout(() => alertDiv.remove(), 500);
            }, 5000);
        }

        // Vérification des mots interdits
        const foundWords = badwords.filter(word => content.includes(word.toLowerCase()));
        
        if (foundWords.length > 0) {
            e.preventDefault();
            showBadWordAlert(`Mot(s) interdit(s) détecté(s) : ${foundWords.join(', ')}`);
            textarea.focus();
            
            // Animation pour mettre en évidence le champ
            textarea.classList.add('is-invalid', 'shake');
            setTimeout(() => {
                textarea.classList.remove('is-invalid', 'shake');
            }, 2000);
            
            return false;
        }
    });
});


document.addEventListener('DOMContentLoaded', function() {
    // Validation IMMÉDIATE au clic
    document.querySelectorAll('.comment-form form').forEach(form => {
        // Intercepter le clic sur le bouton
        const submitBtn = form.querySelector('button[type="submit"]');
        
        submitBtn.addEventListener('click', function(e) {
            const textarea = form.querySelector('textarea');
            const content = textarea.value;
            
            // Supprimer les erreurs précédentes
            textarea.classList.remove('is-invalid', 'shake');
            const existingError = textarea.nextElementSibling;
            if (existingError && existingError.classList.contains('invalid-feedback')) {
                existingError.remove();
            }
            
            // Validation IMMÉDIATE
            if (content === '') {
                e.preventDefault();
                showError(textarea, 'Le sujet ne peut pas être vide');
                return false;
            }
            
            if (content.length < 5) {
                e.preventDefault();
                showError(textarea, 'Le sujet doit contenir au moins 5 caractères');
                return false;
            }
        });
    });
    
    function showError(element, message) {
        const errorDiv = document.createElement('div');
        errorDiv.className = 'invalid-feedback d-block mt-1';
        errorDiv.innerHTML = `<div>${message}</div>`;
        
        element.parentNode.insertBefore(errorDiv, element.nextSibling);
        element.classList.add('is-invalid', 'shake');
        
        setTimeout(() => element.classList.remove('shake'), 500);
        element.focus();
    }
    
    // Suppression des erreurs lors de la saisie
    document.querySelectorAll('.comment-form textarea').forEach(textarea => {
        textarea.addEventListener('input', function() {
            if (this.classList.contains('is-invalid')) {
                this.classList.remove('is-invalid');
                const errorDiv = this.nextElementSibling;
                if (errorDiv && errorDiv.classList.contains('invalid-feedback')) {
                    errorDiv.remove();
                }
            }
        });
    });
});



