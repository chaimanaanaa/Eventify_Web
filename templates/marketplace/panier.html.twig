<head>
    <link rel="stylesheet" href="{{ asset('css/cart.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.6;
            color: #222;
            background-color: #f0f2f5;
            padding: 0;
            margin: 0;
            min-height: 100vh;
        }
        
        .receipt-container {
            max-width: 600px;
            margin: 40px auto;
            padding: 30px;
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 0 25px rgba(0,0,0,0.1);
            border-top: 6px solid #ADC29B;
            position: relative;
        }
        
        .receipt-header {
            text-align: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px dashed #d1d9e6;
        }
        
        .receipt-header h2 {
            color: #1a2e35;
            margin: 0 0 10px;
            font-weight: 700;
            font-size: 28px;
        }
        
        .receipt-date {
            color: #5a6b7c;
            font-size: 14px;
            margin-bottom: 5px;
        }
        
        .receipt-items {
            margin-bottom: 25px;
        }
        
        .receipt-item {
            display: flex;
            padding: 15px 0;
            border-bottom: 1px solid #e1e8ed;
            align-items: center;
        }
        
        .receipt-item:last-child {
            border-bottom: none;
        }
        
        .item-image {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 4px;
            margin-right: 15px;
            border: 1px solid #e1e8ed;
        }
        
        .item-details {
            flex-grow: 1;
        }
        
        .item-name {
            font-weight: 600;
            color: #2d3748;
            margin-bottom: 5px;
        }
        
        .item-price {
            font-weight: 700;
            color: #1a2e35;
        }
        
        .item-remove {
            margin-left: 15px;
        }
        
        .receipt-totals {
            margin: 25px 0;
            padding: 20px;
            background-color: #f8f9fa;
            border-radius: 8px;
            border: 1px solid #e1e8ed;
        }
        
        .total-line {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 16px;
        }
        
        .total-line:last-child {
            margin-bottom: 0;
            padding-top: 12px;
            border-top: 1px dashed #d1d9e6;
            font-weight: 800;
            font-size: 18px;
            color: #1a2e35;
        }
        
        .receipt-footer {
            text-align: center;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px dashed #d1d9e6;
            color: #5a6b7c;
            font-size: 14px;
        }
        
        .button-group {
            display: flex;
            justify-content: space-between;
            margin-top: 30px;
        }
        
        .btn {
            display: inline-block;
            padding: 12px 24px;
            text-decoration: none;
            border-radius: 6px;
            font-size: 15px;
            cursor: pointer;
            border: none;
            transition: all 0.2s ease;
            font-weight: 600;
        }
        
        .btn-outline {
            background-color: transparent;
            border: 1px solid #ADC29B;
            color: #ADC29B;
        }
        
        .btn-outline:hover {
            background-color: #f0f4f8;
        }
        
        .btn-primary {
            background-color: #ADC29B;
            color: white;
            box-shadow: 0 2px 10px rgba(173, 194, 155, 0.3);
        }
        
        .btn-primary:hover {
            background-color: #9bb486;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(173, 194, 155, 0.4);
        }
        
        .btn-danger {
            background-color: transparent;
            color: #ff4444;
            padding: 8px;
            font-size: 16px;
            border-radius: 4px;
            border: none;
            transition: all 0.3s ease;
        }
        
        .btn-danger:hover {
            animation: shake 0.5s;
            animation-iteration-count: 1;
        }
        
        @keyframes shake {
            0% { transform: translateX(0) rotate(0deg); }
            20% { transform: translateX(-3px) rotate(-5deg); }
            40% { transform: translateX(3px) rotate(5deg); }
            60% { transform: translateX(-3px) rotate(-5deg); }
            80% { transform: translateX(3px) rotate(5deg); }
            100% { transform: translateX(0) rotate(0deg); }
        }
        
        .alert {
            padding: 15px 20px;
            margin-bottom: 25px;
            border-radius: 6px;
            text-align: center;
            font-size: 15px;
            border: 1px solid transparent;
        }
        
        .alert-success {
            background-color: #f0fff4;
            border-color: #c6f6d5;
            color: #2f855a;
        }
        
        .alert-warning {
            background-color: #fffaf0;
            border-color: #fed7aa;
            color: #c05621;
        }
        
        .thank-you-message {
            text-align: center;
            margin: 25px 0;
            color: #4a5568;
            font-style: italic;
            line-height: 1.6;
        }
        
        .empty-cart-message {
            text-align: center;
            padding: 40px 0;
            color: #718096;
            font-size: 18px;
        }
        
        .eventify-logo {
            display: block;
            margin: 30px auto 0;
            height: 200px;
            opacity: 0.8;
        }
    </style>
</head>

<body>
    <div class="receipt-container">
        <div class="receipt-header">
            <h2>Your Order Receipt</h2>
            <div class="receipt-date">{{ "now"|date("F j, Y") }}</div>
        </div>
<!--
        {% for message in app.flashes('warning') %}
            <div class="alert alert-warning">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}-->

        <div class="receipt-items">
            {% if cartItems is empty %}
                <div class="empty-cart-message">
                    <i class="fas fa-shopping-cart fa-3x mb-3" style="color: #ADC29B;"></i>
                    <p>Your cart is empty</p>
                </div>
            {% else %}
                {% for item in cartItems %}
                <div class="receipt-item">
                    <img src="{{ item.img }}" class="item-image" alt="{{ item.name }}">
                    <div class="item-details">
                        <div class="item-name">{{ item.name }}</div>
                        <div class="item-price">{{ item.prix }} DT</div>
                    </div>
                    <div class="item-remove">
                        <a href="{{ path('cart_remove', {'id': item.id}) }}" class="btn btn-danger" 
                           onclick="return confirm('Are you sure you want to remove this item?');">
                            <i class="fas fa-trash-alt"></i>
                        </a>
                    </div>
                </div>
                {% endfor %}
            {% endif %}
        </div>

        {% if cartItems is not empty %}
        <div class="receipt-totals">
            <div class="total-line">
                <span>Subtotal:</span>
                <span>{{ totalSum }} DT</span>
            </div>
            <div class="total-line">
                <span>Shipping:</span>
                <span>7 DT</span>
            </div>
            <div class="total-line">
                <span>Total:</span>
                <span>{{ totalSum + 7 }} DT</span>
            </div>
        </div>
        {% endif %}

        <div class="button-group">
            <a href="{{ path('app_shop') }}" class="btn btn-outline">Back to Shop</a>
            {% if cartItems is not empty %}
                <a href="{{ path('cart_view') }}" class="btn btn-primary">Proceed to Checkout</a>
            {% endif %}
        </div>

        <div class="thank-you-message">
            <p>Thank you for shopping with us. Your satisfaction is our priority. 💚</p>
        </div>

        <img src="{{ asset('images/logo.png') }}" alt="Eventify Logo" class="eventify-logo">
        
        <div class="receipt-footer">
            <p>&copy; {{ "now"|date("Y") }} Eventify. All rights reserved.</p>
        </div>
    </div>
</body>