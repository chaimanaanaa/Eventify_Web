{% extends 'base.html.twig' %}

{% block title %}User index{% endblock %}

{% block content %}
    <h1>User index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id_user</th>
                <th>FirstName</th>
                <th>LastName</th>
                <th>Cin</th>
                <th>Email</th>
                <th>NumTlf</th>
                <th>Genre</th>
                <th>Mdp</th>
                <th>DateNaissance</th>
                <th>Role</th>
                <th>Img</th>
                <th>Blocked</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.idUser }}</td>
                <td>{{ user.firstName }}</td>
                <td>{{ user.lastName }}</td>
                <td>{{ user.cin }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.numTlf }}</td>
                <td>{{ user.genre }}</td>
                <td>{{ user.mdp }}</td>
                <td>{{ user.dateNaissance ? user.dateNaissance|date('Y-m-d') : '' }}</td>
                <td>{{ user.role }}</td>
                <td>{{ user.img }}</td>
                <td>{{ user.blocked }}</td>
                <td>
                    <a href="{{ path('app_user_show', {'id_user': user.id_user}) }}">show</a>
                    <a href="{{ path('app_user_edit', {'id_user': user.id_user}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="13">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_user_new') }}">Create new</a>
{% endblock %}
